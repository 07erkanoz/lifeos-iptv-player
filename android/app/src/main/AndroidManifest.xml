<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android TV: Declare that touch screen is NOT required -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Android TV: Declare Leanback support -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <!-- Android TV: RECORD_AUDIO implies android.hardware.microphone as
         "required", which would hide the app from mic-less TV boxes on
         the Play Store. Voice chat is an optional mobile-only extra. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- Android TV: the Wi-Fi permissions imply android.hardware.wifi as
         "required", excluding Ethernet-only TV devices. Declare it
         optional — discovery degrades gracefully without Wi-Fi. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Internet permission for IPTV streaming -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network/Wi-Fi state — required for reliable mDNS / SSDP
         discovery (Chromecast + DLNA). Without ACCESS_WIFI_STATE the
         multicast lock and Wi-Fi interface checks the cast/bonsoir
         stacks rely on can silently no-op, leaving the device list
         empty. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Chromecast: mDNS multicast for device discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Chromecast: Wi-Fi device discovery (Android 13+) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Local reminder notifications (agent setReminder tool). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Keep the screen awake during video playback (TV + mobile). The
         wakelock_plus plugin merges this in too, but declaring it here is
         explicit and survives any plugin/merge change. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Voice chat with AI assistant (mobile only).
         Runtime-requested before the user's first mic tap; the
         speech_to_text plugin also needs the queries block at the
         bottom of this manifest to find the SpeechRecognizer
         service on Android 11+. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="LifeosTV"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@mipmap/tv_banner"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true">
            <!-- Normal Theme after Flutter loads -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Standard launcher for phones/tablets -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Android TV Leanback launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Flutter embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- NOTE: Impeller left at the Flutter default (ON). Disabling it
             (EnableImpeller=false) was tried to calm general TV instability
             but it broke video_player's texture rendering on this Flutter
             version (ExoPlayer video stopped showing) — the Skia GL path is
             under-maintained since Impeller became default. Keep Impeller
             ON; stability is handled via the memory fix (skip media_kit init
             on TV) instead. Revisit only with device logs. -->
    </application>
    <!-- Required for text processing -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for url_launcher (open YouTube trailer etc.) -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- speech_to_text on Android 11+ must declare the
             SpeechRecognizer service it intends to bind to,
             otherwise the plugin returns "not available" even when
             Google's speech services are installed. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- flutter_tts on Android 11+ requires this query to
             discover the platform TTS engine. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
